<IfModule mod_rewrite.c>
    RewriteEngine On

    # ============ 1. REDIRECT WWW KE NON-WWW ============
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^(.*)$ https://%1%{REQUEST_URI} [R=301,L]

    # ============ 2. REDIRECT HTTP KE HTTPS (ANTI-LOOP & ENV-SAFE) ============
    RewriteCond %{HTTPS} !on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteCond %{HTTP_HOST} !^192\.168\. [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # ============ 3. FILE STATIS ============
    RewriteRule ^tutorial/promenade$ public/promenade.html [L]
    RewriteRule ^tutorial/project$ public/project.mp3 [L]

    # ============ 4. ROUTING CODEIGNITER 3 (SELF-ADAPTIVE / SUBFOLDER SAFE) ============
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php/$1 [QSA,L]
</IfModule>

# ============ 5. HEADER CORS ============
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
</IfModule>
